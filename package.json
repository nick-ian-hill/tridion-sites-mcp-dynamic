{
  "name": "tridion-sites-mcp-optimized",
  "version": "0.1.0",
  "description": "Optimized Tridion Sites MCP server. Uses a discovery-based pattern (getToolDetails/callTool) to minimize LLM token consumption.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "start:stdio": "tsx src/index.ts --stdio",
    "start:mock": "CORE_API_URL=http://localhost:8081/api/v3.0 AUTH_TOKEN_URL=http://localhost:8081/access-management/connect/token AUTH_CLIENT_ID=mock AUTH_CLIENT_SECRET=mock tsx src/index.ts --http",
    "orchestrator": "tsx src/runOrchestratorTest.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.11.0",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "pdfreader": "^3.0.8",
    "qs": "^6.14.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "hono": "^4.12.14",
    "glob": "^8.1.0",
    "rimraf": "^3.0.2",
    "pdf2json": "^4.0.3",
    "follow-redirects": "^1.16.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/qs": "^6.14.0",
    "@types/xml2js": "^0.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
